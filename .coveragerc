[run]
branch = True
source =
    scripts
    plugins/hotspot-to-rq/skills/research-direction-debate/scripts
omit =
    tests/*
    plugins/hotspot-to-rq/skills/research-direction-debate/vendor/*

[report]
show_missing = True
skip_covered = False
precision = 1

[html]
directory = htmlcov

[xml]
output = coverage.xml
